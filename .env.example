# Copiar a .env y ajustar. No commitear .env (contiene valores locales de desarrollo).

DEBUG=True
SECRET_KEY=changeme-genera-una-clave-real-para-produccion
ALLOWED_HOSTS=localhost,127.0.0.1

# Debe coincidir con POSTGRES_* abajo (host "db" = nombre del servicio en docker-compose.yml)
DATABASE_URL=postgres://orbita:orbita@db:5432/orbita
POSTGRES_DB=orbita
POSTGRES_USER=orbita
POSTGRES_PASSWORD=orbita

REDIS_URL=redis://redis:6379/0
# Opcional: Redis de la capa de canales (Conversación del ticket en tiempo real). Sin definir, usa REDIS_URL.
# CHANNELS_REDIS_URL=redis://redis:6379/1

TIME_ZONE=America/Bogota

# URL del entorno (no cambiar 127.0.0.1 por localhost en el flujo OAuth).
APP_BASE_URL=http://127.0.0.1:8000

# Acceso Google: copiar del objeto "web" del JSON del cliente OAuth.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Registrar esta URI exacta en GCP. Ruta prevista, pendiente de implementar.
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback/
GOOGLE_OAUTH_ALLOWED_DOMAINS=edilandina.com,gammaingenieros.com

# Gmail: credenciales del JSON de CUENTA DE SERVICIO, distinto del OAuth web.
GMAIL_SERVICE_ACCOUNT_EMAIL=correo-orbita@software-orbita-513614.iam.gserviceaccount.com
# client_id numérico de la cuenta de servicio, usado también para la delegación.
GMAIL_SERVICE_ACCOUNT_CLIENT_ID=
GMAIL_SERVICE_ACCOUNT_PRIVATE_KEY_ID=
# Pegar private_key entre comillas simples, en UNA línea, conservando los \n.
# Ejemplo de formato: '-----BEGIN PRIVATE KEY-----\nCONTENIDO\n-----END PRIVATE KEY-----\n'
GMAIL_SERVICE_ACCOUNT_PRIVATE_KEY=
# Buzón Workspace que la cuenta de servicio representará mediante delegación.
GMAIL_SENDER_EMAIL=desarrollador.automatizacion@edilandina.com

# Alternativa para pruebas: autorizar el buzón desde /auth/gmail/ como superusuario.
# Tras aceptar en Google, Órbita guarda el token en .env y cambia el modo a oauth.
GMAIL_AUTH_MODE=service_account
GMAIL_REFRESH_TOKEN=
GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/gmail/callback/

# Notificaciones y alertas: el correo de los avisos solo sale con este interruptor encendido.
NOTIFICACIONES_CORREO_ACTIVO=False
# Opcional (desarrollo/staging): todo correo de avisos se envía a este buzón en lugar del destinatario real.
CORREO_REDIRIGIR_A=

# Conversación del ticket en Google Chat (delegación de dominio). Apagado por defecto.
# Cuenta de servicio con DELEGACIÓN DE DOMINIO (si se dejan vacías, se usa la de Gmail): el administrador de
# Workspace autoriza para su client_id los scopes chat.spaces, chat.memberships y chat.messages.
GOOGLE_CHAT_ACTIVO=False
GOOGLE_CHAT_SERVICE_ACCOUNT_EMAIL=
GOOGLE_CHAT_SERVICE_ACCOUNT_PRIVATE_KEY_ID=
# Igual que la de Gmail: entre comillas simples, en UNA línea, conservando los \n.
GOOGLE_CHAT_SERVICE_ACCOUNT_PRIVATE_KEY=
# Cuenta de Workspace que crea y administra los espacios (p. ej. la remitente de los avisos).
GOOGLE_CHAT_CUENTA=
# Opcional (desarrollo/staging): solo estos correos entran a los espacios, separados por coma.
GOOGLE_CHAT_PERMITIDOS=
# Opcional (tiempo real): tema y suscripción PULL de Pub/Sub, formato projects/<p>/topics/<t> y
# projects/<p>/subscriptions/<s>. Sin ellos, lo escrito en Chat llega a Órbita cada minuto.
GOOGLE_CHAT_PUBSUB_TEMA=
GOOGLE_CHAT_PUBSUB_SUSCRIPCION=

# Solo desarrollo: barra de depuración de Django (apagada por defecto; en Docker se activaba sola y hacía lenta cada página).
DEBUG_TOOLBAR=False

# Administración avanzada (Versión 1): APAGADA en el sitio público. La enciende solo el contenedor `admin`
# (docker-compose: profile «admin», publicado en 127.0.0.1:8001; en el servidor, por túnel SSH). Exige el permiso
# plataforma.administracion_avanzada (el primero lo da `manage.py otorgar_administrador`) y un ingreso con Google
# de esta misma sesión de hace menos de estos minutos.
ADMIN_HABILITADA=False
ADMIN_REAUTENTICACION_MINUTOS=30
