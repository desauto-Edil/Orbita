# Órbita — variables de PRODUCCIÓN (Versión 1, etapa 8).
# Copiar en el servidor como `.env` junto a docker-compose.prod.yml, con permisos 600 (chmod 600 .env).
# Nunca en el repositorio. Genera cada secreto con:   openssl rand -hex 32
# (letras y números: sin comillas ni símbolos que haya que escapar en una URL).

# --- Aplicación ---
DEBUG=False
SECRET_KEY=
DOMINIO=orbita.tu-dominio.com
ALLOWED_HOSTS=orbita.tu-dominio.com
APP_BASE_URL=https://orbita.tu-dominio.com
CSRF_TRUSTED_ORIGINS=https://orbita.tu-dominio.com
TIME_ZONE=America/Bogota
LOG_LEVEL=INFO
# Correo para avisos de Let's Encrypt (vencimiento o problemas del certificado).
ACME_EMAIL=

# --- Base de datos (red interna de Docker; sin puerto publicado) ---
# Superusuario: solo inicializa y sirve para mantenimiento. La aplicación NUNCA lo usa.
POSTGRES_DB=orbita
POSTGRES_USER=orbita_admin
POSTGRES_PASSWORD=
# Rol de la aplicación (sin superusuario), lo crea deploy/postgres/crear_rol_aplicacion.sh la primera vez.
ORBITA_DB_USER=orbita_app
ORBITA_DB_PASSWORD=
# Debe usar el rol de la aplicación y el host «db».
DATABASE_URL=postgres://orbita_app:LA_MISMA_ORBITA_DB_PASSWORD@db:5432/orbita

# --- Redis (red interna; con contraseña) ---
REDIS_PASSWORD=
REDIS_URL=redis://:LA_MISMA_REDIS_PASSWORD@redis:6379/0
# Opcional: canales del WebSocket en otra base de Redis.
# CHANNELS_REDIS_URL=redis://:LA_MISMA_REDIS_PASSWORD@redis:6379/1

# --- HTTPS (Caddy termina el TLS) ---
SITIO_HTTPS=True
SECURE_HSTS_SECONDS=31536000
# Con Órbita en su propio subdominio solo afecta a *.orbita.tu-dominio.com: seguro encenderlo.
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# La lista preload solo admite el dominio raíz: no aplica a un subdominio (déjalo en False).
SECURE_HSTS_PRELOAD=False
# Una jornada (segundos).
SESSION_COOKIE_AGE=36000

# --- Ingreso con Google (cliente OAuth de PRODUCCIÓN, pantalla de consentimiento EXTERNA en producción) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://orbita.tu-dominio.com/auth/google/callback/
GOOGLE_OAUTH_ALLOWED_DOMAINS=edilandina.com,gammaingenieros.com

# --- Correo (cuenta de servicio con delegación de dominio, solo gmail.send) ---
GMAIL_AUTH_MODE=service_account
GMAIL_SERVICE_ACCOUNT_EMAIL=
GMAIL_SERVICE_ACCOUNT_CLIENT_ID=
GMAIL_SERVICE_ACCOUNT_PRIVATE_KEY_ID=
# Entre comillas simples, en UNA línea, conservando los \n.
GMAIL_SERVICE_ACCOUNT_PRIVATE_KEY=
GMAIL_SENDER_EMAIL=
NOTIFICACIONES_CORREO_ACTIVO=True
# Vacío en producción (en staging: un buzón de pruebas).
CORREO_REDIRIGIR_A=

# --- Google Chat: pospuesto ---
GOOGLE_CHAT_ACTIVO=False

# --- Administración avanzada: siempre apagada aquí; la enciende solo el contenedor `admin` (túnel SSH) ---
ADMIN_HABILITADA=False
ADMIN_REAUTENTICACION_MINUTOS=30

# --- Bienvenida de cinco pasos para cada persona hasta que la complete u omita ---
BIENVENIDA_OBLIGATORIA=True
